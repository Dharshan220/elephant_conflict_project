# TuskerGuard backend environment (copy to .env and adjust)
# JWT signing secret - CHANGE THIS IN PRODUCTION
TUSKER_JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (override to use a different path)
TUSKER_DB_PATH=
# PostgreSQL / Supabase connection string.
# When set, the app uses PostgreSQL instead of SQLite.
# Note: URL-encode special characters in the password (space -> %20).
# Example (Supabase pooler):
# TUSKER_DB_URL=postgresql://postgres:PASSWORD@zlcrynxxyxqdbvsqzmkl.supabase.co:6543/postgres
TUSKER_DB_URL=
# Firebase Admin service-account JSON (relative to backend/, or absolute path)
# Leave unset for mock push mode
TUSKER_FCM_CREDENTIALS=firebase/tuskerguard-credentials.json
