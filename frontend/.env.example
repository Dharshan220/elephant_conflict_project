# TuskerGuard frontend environment (copy to .env and adjust)
# Backend API base URL
VITE_API_URL=http://localhost:8000
# WebSocket URL for the live alert stream
VITE_WS_URL=ws://localhost:8000
# Firebase Web config (optional - app falls back to the built-in elephant-67342
# project config if these are empty)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
